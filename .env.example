# EcoBus customer website — copy to .env.local for local dev
# Production: set these in your host (Vercel/Fly/etc.) BEFORE build.

# Django API base including /api/v1 (required in production)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# When true, show local marketing fallbacks if the API returns no routes.
# Keep false in production.
NEXT_PUBLIC_USE_LOCAL_DATA=false

# Public origin of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ecobus.co.ss

# WhatsApp support number in international format (digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=211926388115
